{
  "name": "sql-db-diff",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only database comparison for macOS",
  "author": "SQL DB Diff",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src electron tests scripts vite.config.ts",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.6.3",
    "mysql2": "^3.14.0",
    "pg": "^8.16.0",
    "pg-cursor": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pg-cursor": "^2.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "build": {
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "appId": "com.sqldbdiff.desktop",
    "productName": "SQL DB Diff",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
