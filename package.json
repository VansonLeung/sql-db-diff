{
  "name": "sql-db-diff",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only database comparison with Electrobun",
  "author": "SQL DB Diff",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electrobun run",
    "test": "bun test ./tests --timeout 120000",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "electrobun prepare && tsc --noEmit",
    "format": "prettier --write src desktop tests scripts *.ts",
    "dist": "node scripts/build.mjs --release",
    "dist:mac": "node scripts/build.mjs --release --platform=darwin",
    "dist:win": "node scripts/build.mjs --release --platform=win32",
    "postinstall": "node node_modules/bun/install.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.6.3",
    "mysql2": "^3.14.0",
    "pg": "^8.16.0",
    "pg-cursor": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pg-cursor": "^2.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^6.0.0",
    "bun": "1.4.0",
    "electrobun": "2.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
